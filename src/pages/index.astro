---
/**
 * Home (§4). Theme: direction A, "drafting paper".
 *
 * Copy lives in src/content/home.ts; lines marked [decide] / [supply] there
 * are drafted from the spec and are NOT final.
 */
import Shell from '../layouts/Shell.astro';
import '../styles/themes/home.css';
import HeroScene from '../scenes/HeroScene.astro';
import ChapterScene from '../scenes/ChapterScene.astro';
import { chapters, cta, positioning, services } from '../content/home';
---

<Shell
  title="Serhii Pemakhov — mechanical design to AI-first development"
  description={positioning}
  theme="home"
>
  <!-- 1. Hero (R1, R2). The motif is pinned mid-screen and driven by scroll. -->
  <section aria-labelledby="hero-heading">
    <HeroScene>
      <p class="annotation">Serhii Pemakhov</p>
      <h1 class="h1 prose" id="hero-heading">{positioning}</h1>
      <p class="hero-cta"><a class="cta" href={cta.href}>{cta.label}</a></p>
    </HeroScene>
  </section>

  <!-- 2. Story — three chapters, each one pinned scene (R3, R12, R13) -->
  <section class="story" aria-labelledby="story-heading">
    <div class="container">
      <h2 class="h2 prose" id="story-heading">Three materials, one habit</h2>
    </div>
    {
      chapters.map((chapter, index) => (
        <ChapterScene scene={chapter.scene} labelledBy={`${chapter.scene}-heading`}>
          <p class="annotation">{`Chapter ${index + 1} · ${chapter.period}`}</p>
          <h3 class="h3" id={`${chapter.scene}-heading`}>
            {chapter.title}
          </h3>
          <p class="chapter-hook">{chapter.hook}</p>
          <p>{chapter.body}</p>
          <p>
            <strong>What carried over:</strong> {chapter.carried}
          </p>
        </ChapterScene>
      ))
    }
  </section>

  <!-- 3. What I can do for you (R5, R15) -->
  <section class="section container" id="services" aria-labelledby="services-heading">
    <h2 class="h2 prose" id="services-heading">What I can do for you</h2>
    <div class="prose">
      {
        services.map((service) => (
          <article>
            <h3 class="h3">{service.title}</h3>
            <p class="annotation">{service.need}</p>
            <p>[supply §9] Two sentences: what I do, what you get.</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 4. Selected work (R6) -->
  <section class="section container" id="work" aria-labelledby="work-heading">
    <h2 class="h2 prose" id="work-heading">Selected work</h2>
    <p class="prose">
      [supply §3.5] Two to four case studies: problem → what I built → result → stack.
      Phase 5 reads these from src/content/work/.
    </p>
  </section>

  <!-- 5. How I work (R7) -->
  <section class="section container" aria-labelledby="process-heading">
    <h2 class="h2 prose" id="process-heading">How I work</h2>
    <figure class="figure" data-scene="process">
      <p class="annotation">[Phase 5] The AI-first loop, one diagram</p>
    </figure>
  </section>

  <!-- 6. Contact (R8) -->
  <section class="section container" id="contact" aria-labelledby="contact-heading">
    <h2 class="h2 prose" id="contact-heading">Contact</h2>
    <!-- §3.3: the motif appears here one last time, at rest, with the CTA as its only note. -->
    <figure class="figure" data-scene="contact">
      <p class="annotation">[Phase 5] Motif at rest</p>
    </figure>
    <p><a class="cta" href={cta.href}>{cta.label}</a></p>
    <p class="annotation">[supply §9] Location and time zone</p>
  </section>
</Shell>

<style>
  .hero-cta {
    margin-block-start: var(--space-3);
  }

  .story {
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--rule);
  }

  .chapter-hook {
    font-size: var(--type-1);
    line-height: var(--leading-heading);
  }
</style>
