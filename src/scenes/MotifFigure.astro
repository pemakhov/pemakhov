---
/**
 * Renders one scene's frame as SVG + a notes list, at build time, then (in the
 * script) drives it from scroll. Layout — the tall track and the sticky
 * stage — belongs to the wrapper (HeroScene, ChapterScene): this component
 * only needs an ancestor marked `data-scene-track`.
 *
 * First paint never depends on JS: the markup is scene.evaluate(scene.buildT).
 */
import { drawList, groupTransform, VIEWBOX } from '../diagram/motif/kinematics';
import { SCENES } from '../diagram/storyboard';
import '../diagram/primitives/drawing.css';

interface Props {
  scene: string;
}

const scene = SCENES[Astro.props.scene];
if (!scene) throw new Error(`Unknown scene "${Astro.props.scene}"`);

const frame = scene.evaluate(scene.buildT);
const items = drawList(frame.motif);
const titleId = `${scene.id}-title`;
const stateClass = (state: string | null | undefined): string =>
  state === 'fault' ? 'is-fault' : state === 'active' ? 'is-active' : '';
const opacity = (n: number): string => `opacity:${n.toFixed(3)}`;
---

<figure class="scene-figure" data-scene={scene.id}>
  <div class="scene-drawing">
    <svg viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`} role="img" aria-labelledby={titleId}>
      <title id={titleId}>{scene.description}</title>
      <g
        data-motif
        transform={groupTransform(frame.motif)}
        style={`--dg-detail-opacity:${frame.motif.detail}`}
      >
        <path class="dg-centerline" d="M0 -490V490" />
        {
          items.map((item) => (
            <path
              class:list={[
                item.cls,
                item.part !== undefined && stateClass(frame.partState[item.part]),
              ]}
              data-key={item.key}
              d={item.d}
            />
          ))
        }
      </g>
      <g>
        {
          frame.marks.map((mark) => (
            <path
              class:list={[mark.cls, stateClass(mark.state)]}
              data-mark={mark.key}
              d={mark.d}
              style={opacity(mark.opacity)}
            />
          ))
        }
      </g>
      <g aria-hidden="true">
        {
          frame.tags.map((tag) => (
            <text
              class:list={['dg-note', tag.tone === 'fault' && 'dg-note--fault']}
              data-tag={tag.key}
              x={tag.x}
              y={tag.y}
              text-anchor={tag.anchor}
              style={opacity(tag.opacity)}
            >
              {tag.text}
            </text>
          ))
        }
      </g>
    </svg>
  </div>

  {
    frame.captions.length > 0 && (
      <ul class="scene-captions" role="list">
        {frame.captions.map((caption) => (
          <li
            class:list={['scene-caption', caption.tone && `scene-caption--${caption.tone}`]}
            data-caption={caption.key}
            style={opacity(caption.opacity)}
          >
            {caption.text}
          </li>
        ))}
      </ul>
    )
  }
</figure>

<script>
  import { SCENES } from '../diagram/storyboard';
  import { attachScrollDriver } from '../diagram/motion/driver';
  import { mountScene } from '../diagram/motion/mount';
  import { prefersReducedMotion } from '../diagram/motion/reduced-motion';

  const reduced = prefersReducedMotion();

  for (const figure of document.querySelectorAll<HTMLElement>('[data-scene]')) {
    const scene = SCENES[figure.dataset.scene ?? ''];
    const track = figure.closest<HTMLElement>('[data-scene-track]');
    if (!scene || !track) continue;

    const render = mountScene(figure, scene);
    // Anything in the track that shows progress, e.g. the hero's ruler.
    const progressMarks = track.querySelectorAll<SVGElement>('[data-progress-mark]');
    const renderWithProgress = (t: number): void => {
      render(t);
      for (const mark of progressMarks) {
        const width = Number(mark.dataset.progressWidth ?? 0);
        mark.setAttribute('transform', `translate(${(t * width).toFixed(1)} 0)`);
      }
    };

    if (reduced) {
      renderWithProgress(scene.staticT);
    } else {
      attachScrollDriver(track, renderWithProgress);
    }
  }
</script>

<style>
  .scene-figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-2);
    height: 100%;
    min-height: 0;
  }

  /* The grid row decides the drawing's height; the SVG then fills that box
     and its viewBox letterboxes the square drawing inside it. */
  .scene-drawing {
    position: relative;
    min-height: 0;
  }

  .scene-drawing svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }

  .scene-drawing :global(.dg-note) {
    font-size: 22px;
  }

  /* The drawing scales down with the screen; its tags must stay legible. */
  @media (max-width: 40em) {
    .scene-drawing :global(.dg-note) {
      font-size: 27px;
    }
  }

  /* General notes, the way they sit under a drawing's views. Every line keeps
     its space while invisible, so notes appearing never shift the layout. */
  .scene-captions {
    display: grid;
    gap: var(--space-1);
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--space-3);
    font-family: var(--font-annotation);
    font-size: var(--type--1);
    line-height: var(--leading-heading);
    color: var(--ink-secondary);
  }

  .scene-caption--fault {
    color: var(--dg-fault);
  }

  .scene-caption--log {
    color: var(--ink);
  }
</style>
