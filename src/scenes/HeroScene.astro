---
/**
 * Hero (§5.2): the motif pinned in the middle of the screen, driven by scroll
 * through a tall track. Copy arrives through the slot.
 *
 * Without script, or with reduced motion, the track is one screen tall and
 * the figure shows a single frame — there is nothing to scrub.
 */
import MotifFigure from './MotifFigure.astro';

// Progress ruler: a tick every 8 units, a long tick every 5th.
const RULER_WIDTH = 320;
const RULER_STEP = 8;
const rulerTicks = Array.from({ length: RULER_WIDTH / RULER_STEP + 1 }, (_, i) => {
  const x = i * RULER_STEP;
  return i % 5 === 0 ? `M${x} 4V20` : `M${x} 8V16`;
}).join('');
---

<div class="hero-track" data-scene-track>
  <div class="hero-stage">
    <div class="hero-copy container">
      <slot />
    </div>

    <div class="hero-figure">
      <MotifFigure scene="hero" />
    </div>

    <svg class="hero-ruler" viewBox={`-8 0 ${RULER_WIDTH + 16} 24`} aria-hidden="true">
      <path class="hero-ruler__ticks" d={rulerTicks} />
      <path
        class="hero-ruler__mark"
        data-progress-mark
        data-progress-width={RULER_WIDTH}
        d="M0 2V22"
      />
    </svg>
  </div>
</div>

<style>
  .hero-track {
    position: relative;
  }

  .hero-stage {
    position: relative;
    height: 100dvh;
    min-height: 32rem;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
  }

  /* Only a scrubbable page gets the tall track and the pin. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .hero-track {
      height: 420vh;
    }
    .hero-stage {
      position: sticky;
      top: 0;
    }
  }

  .hero-copy {
    padding-block-start: var(--space-4);
  }

  .hero-figure {
    min-height: 0;
    margin: var(--space-2) var(--space-3) var(--space-5);
  }

  /* Wide screens: the drawing takes the whole stage and the copy sits in its
     top-left corner, clear of the notes (top-right and bottom-left). */
  @media (min-width: 64em) {
    .hero-stage {
      grid-template-rows: minmax(0, 1fr);
    }
    .hero-copy,
    .hero-figure {
      grid-area: 1 / 1;
    }
    .hero-copy {
      position: relative;
      z-index: 1;
      align-self: start;
      max-width: 30rem;
      margin-inline: 0;
      padding-inline-start: var(--space-5);
    }
    .hero-figure {
      margin: var(--space-3) var(--space-3) var(--space-4);
    }
  }

  .hero-ruler {
    position: absolute;
    inset-inline-end: var(--space-3);
    inset-block-end: var(--space-3);
    width: min(16rem, 50vw);
    height: auto;
    padding: var(--space-1) var(--space-2);
    background: var(--ink);
  }

  .hero-ruler__ticks {
    fill: none;
    stroke: var(--ink-secondary);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* The ruler mark is "where you are now" — the current state §5.4 allows
     the accent for. */
  .hero-ruler__mark {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
</style>
