---
/**
 * §4: "Navigation: name (links home), Work, AI, Contact. Nothing else."
 *
 * /work and /ai are listed in the spec's IA but are later pages. Entries carry
 * a `ready` flag so the nav degrades honestly instead of linking to a 404;
 * flip the flag when the page lands. Until then Home's nav points at the
 * in-page anchors, which also satisfies R15 (services reachable in one scroll).
 */
const links = [
  { href: '/#services', label: 'What I can do', ready: true },
  { href: '/work', label: 'Work', ready: false },
  { href: '/ai', label: 'AI', ready: false },
  { href: '/#contact', label: 'Contact', ready: true },
].filter((link) => link.ready);
---

<nav class="shell-nav" aria-label="Primary">
  <div class="container shell-nav__inner">
    <a class="shell-nav__name" href="/">Serhii Pemakhov</a>
    {links.map((link) => <a class="shell-nav__link" href={link.href}>{link.label}</a>)}
  </div>
</nav>
